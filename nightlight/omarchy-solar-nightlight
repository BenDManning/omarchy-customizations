#!/usr/bin/env python3
"""Drive hyprsunset from local solar times with smooth dawn/dusk fades."""

import math
import os
import argparse
import json
import subprocess
import time
import re
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo

DEFAULT_CONFIG = {"enabled": True, "day_temperature": 6500,
                  "night_temperature": 4000, "fade_minutes": 30,
                  "schedule_mode": "solar", "start_minutes": 20 * 60,
                  "end_minutes": 7 * 60, "location_mode": "timezone",
                  "latitude": None, "longitude": None}
CONFIG_PATH = os.path.expanduser("~/.config/omarchy/solar-nightlight.json")
UPDATE_SECONDS = 30
ZONE_TABLES = ("/usr/share/zoneinfo/zone1970.tab", "/usr/share/zoneinfo/zone.tab")


def system_timezone_name():
    target = os.path.realpath("/etc/localtime")
    marker = "/zoneinfo/"
    if marker in target:
        return target.split(marker, 1)[1]
    with open("/etc/timezone", encoding="utf-8") as timezone_file:
        return timezone_file.read().strip()


def compact_coordinate(value, degree_digits):
    sign = -1 if value[0] == "-" else 1
    digits = value[1:]
    degrees = int(digits[:degree_digits])
    minutes = int(digits[degree_digits:degree_digits + 2])
    seconds = int(digits[degree_digits + 2:] or 0)
    return sign * (degrees + minutes / 60 + seconds / 3600)


def system_location(config=None):
    timezone_name = system_timezone_name()
    if config and config["location_mode"] == "manual":
        return ZoneInfo(timezone_name), float(config["latitude"]), float(config["longitude"])
    for table in ZONE_TABLES:
        try:
            rows = open(table, encoding="utf-8")
        except OSError:
            continue
        with rows:
            for row in rows:
                fields = row.rstrip("\n").split("\t")
                if row.startswith("#") or len(fields) < 3 or fields[2] != timezone_name:
                    continue
                match = re.fullmatch(r"([+-]\d{4}(?:\d{2})?)([+-]\d{5}(?:\d{2})?)", fields[1])
                if match:
                    return (ZoneInfo(timezone_name), compact_coordinate(match.group(1), 2),
                            compact_coordinate(match.group(2), 3))
    raise RuntimeError(f"No location found for system timezone {timezone_name!r}")


def solar_event(day, sunrise, tz, latitude, longitude):
    """NOAA sunrise/sunset approximation, returned in the active timezone."""
    zenith = 90.833
    n = day.timetuple().tm_yday
    lng_hour = longitude / 15.0
    approximate = n + ((6 if sunrise else 18) - lng_hour) / 24.0
    mean_anomaly = (0.9856 * approximate) - 3.289
    true_longitude = (
        mean_anomaly
        + 1.916 * math.sin(math.radians(mean_anomaly))
        + 0.020 * math.sin(math.radians(2 * mean_anomaly))
        + 282.634
    ) % 360
    right_ascension = math.degrees(
        math.atan(0.91764 * math.tan(math.radians(true_longitude)))
    ) % 360
    right_ascension += (
        math.floor(true_longitude / 90) * 90
        - math.floor(right_ascension / 90) * 90
    )
    right_ascension /= 15
    declination_sin = 0.39782 * math.sin(math.radians(true_longitude))
    declination_cos = math.cos(math.asin(declination_sin))
    hour_cos = (
        math.cos(math.radians(zenith))
        - declination_sin * math.sin(math.radians(latitude))
    ) / (declination_cos * math.cos(math.radians(latitude)))
    if not -1 <= hour_cos <= 1:
        raise RuntimeError("No sunrise/sunset at the configured latitude today")
    hour_angle = 360 - math.degrees(math.acos(hour_cos)) if sunrise else math.degrees(math.acos(hour_cos))
    hour_angle /= 15
    local_mean_time = (
        hour_angle + right_ascension - 0.06571 * approximate - 6.622
    )
    utc_hours = (local_mean_time - lng_hour) % 24
    utc_midnight = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
    event = (utc_midnight + timedelta(hours=utc_hours)).astimezone(tz)
    # The modulo-24 UTC result can land on the adjacent local calendar day.
    if event.date() < day:
        event += timedelta(days=1)
    elif event.date() > day:
        event -= timedelta(days=1)
    return event


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as config_file:
            loaded = json.load(config_file)
    except (OSError, ValueError):
        loaded = {}
    config = DEFAULT_CONFIG.copy()
    config.update({key: loaded[key] for key in config if key in loaded})
    return config


def save_config(config):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    temporary = CONFIG_PATH + ".tmp"
    with open(temporary, "w", encoding="utf-8") as config_file:
        json.dump(config, config_file, indent=2)
        config_file.write("\n")
    os.replace(temporary, CONFIG_PATH)


def clock_event(now, minutes):
    return now.replace(hour=int(minutes) // 60, minute=int(minutes) % 60,
                       second=0, microsecond=0)


def target_temperature(now, latitude, longitude, config):
    if config["schedule_mode"] == "solar":
        sunrise = solar_event(now.date(), True, now.tzinfo, latitude, longitude)
        sunset = solar_event(now.date(), False, now.tzinfo, latitude, longitude)
    else:
        sunrise = clock_event(now, config["end_minutes"])
        sunset = clock_event(now, config["start_minutes"])
    fade_minutes = max(1, int(config["fade_minutes"]))
    night_temperature = int(config["night_temperature"])
    day_temperature = int(config["day_temperature"])
    half_fade = timedelta(minutes=fade_minutes / 2)

    if sunrise - half_fade <= now <= sunrise + half_fade:
        progress = (now - (sunrise - half_fade)) / timedelta(minutes=fade_minutes)
        value = night_temperature + progress * (day_temperature - night_temperature)
    elif sunset - half_fade <= now <= sunset + half_fade:
        progress = (now - (sunset - half_fade)) / timedelta(minutes=fade_minutes)
        value = day_temperature - progress * (day_temperature - night_temperature)
    elif sunrise + half_fade < now < sunset - half_fade:
        value = day_temperature
    else:
        value = night_temperature
    return round(value), sunrise, sunset


def apply_temperature(value):
    result = subprocess.run(
        ["hyprctl", "hyprsunset", "temperature", str(value)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def current_temperature():
    result = subprocess.run(
        ["hyprctl", "hyprsunset", "temperature"],
        capture_output=True,
        text=True,
        check=False,
    )
    match = re.search(r"\d+", result.stdout) if result.returncode == 0 else None
    return int(match.group()) if match else None


def status(config=None):
    config = config or load_config()
    tz, latitude, longitude = system_location(config)
    now = datetime.now(tz)
    scheduled, sunrise, sunset = target_temperature(now, latitude, longitude, config)
    return {**config, "timezone": str(tz), "latitude": latitude, "longitude": longitude,
            "sunrise": sunrise.strftime("%H:%M"), "sunset": sunset.strftime("%H:%M"),
            "scheduled_temperature": scheduled, "temperature": current_temperature()}


def daemon():
    last_value = None
    last_day = None
    last_location = None
    while True:
        config = load_config()
        tz, latitude, longitude = system_location(config)
        now = datetime.now(tz)
        scheduled, sunrise, sunset = target_temperature(now, latitude, longitude, config)
        value = scheduled if config["enabled"] else int(config["day_temperature"])
        location = (str(tz), latitude, longitude)
        if location != last_location:
            print(f"timezone={tz} latitude={latitude:.4f} longitude={longitude:.4f}", flush=True)
            last_location = location
        if value != last_value or now.date() != last_day or current_temperature() != value:
            if apply_temperature(value):
                last_value = value
                last_day = now.date()
                print(
                    f"{now.isoformat(timespec='seconds')} {value}K "
                    f"sunrise={sunrise:%H:%M} sunset={sunset:%H:%M}",
                    flush=True,
                )
        time.sleep(UPDATE_SECONDS)


def main():
    parser = argparse.ArgumentParser()
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--enable", action="store_true")
    group.add_argument("--disable", action="store_true")
    group.add_argument("--toggle", action="store_true")
    parser.add_argument("--night-temperature", type=int)
    parser.add_argument("--fade-minutes", type=int)
    parser.add_argument("--schedule-mode", choices=("solar", "custom"))
    parser.add_argument("--start-minutes", type=int)
    parser.add_argument("--end-minutes", type=int)
    parser.add_argument("--location-mode", choices=("timezone", "manual"))
    parser.add_argument("--latitude", type=float)
    parser.add_argument("--longitude", type=float)
    parser.add_argument("--status", action="store_true")
    args = parser.parse_args()
    if not any(vars(args).values()):
        daemon()
        return
    config = load_config()
    if args.enable:
        config["enabled"] = True
    elif args.disable:
        config["enabled"] = False
    elif args.toggle:
        config["enabled"] = not config["enabled"]
    if args.night_temperature is not None:
        config["night_temperature"] = max(2500, min(5500, args.night_temperature))
    if args.fade_minutes is not None:
        config["fade_minutes"] = max(1, min(120, args.fade_minutes))
    if args.schedule_mode:
        config["schedule_mode"] = args.schedule_mode
    if args.start_minutes is not None:
        config["start_minutes"] = args.start_minutes % 1440
    if args.end_minutes is not None:
        config["end_minutes"] = args.end_minutes % 1440
    if args.location_mode:
        config["location_mode"] = args.location_mode
    if args.latitude is not None:
        config["latitude"] = max(-90, min(90, args.latitude))
    if args.longitude is not None:
        config["longitude"] = max(-180, min(180, args.longitude))
    if config["location_mode"] == "manual" and (config["latitude"] is None or config["longitude"] is None):
        parser.error("manual location requires latitude and longitude")
    save_config(config)
    state = status(config)
    apply_temperature(state["scheduled_temperature"] if config["enabled"] else config["day_temperature"])
    if args.status:
        print(json.dumps(state))
    else:
        print(json.dumps(config))


if __name__ == "__main__":
    main()
